APP_NAME=usb
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/runtime/usb.sqlite3
DATA_DIR=data
MARKET_TIMEZONE=America/New_York

# Kiwoom is disabled by default. Real values belong only in an ignored local env file
# or the OS environment. Stage 10A supports market data only and simulation brokerage.
MARKET_DATA_PROVIDER=fake
BROKER_PROVIDER=simulation
KIWOOM_ENV=real
KIWOOM_MODE=market_data_only
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_DEFAULT_EXCHANGE=ND
RUN_KIWOOM_LIVE_SMOKE=0
