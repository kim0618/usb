+@dataclass(frozen=True)
+class _ActiveCount:
+    """What `should_rotate` last learned about the active tape.
+
+    `offset` is the byte just past the last newline counted and `complete` the non-blank lines
+    before it. A trailing line with no newline yet is never folded in, so the next reading
+    starts on a line boundary and sees that line whole once it is finished. `head` and `tail`
+    are the first and last bytes of the counted part, as they were when it was counted.
+    """
+    dev: int
+    ino: int
+    offset: int
+    complete: int
+    head: bytes
+    tail: bytes
+
+    @classmethod
+    def read(cls, fd: int, stat: os.stat_result, offset: int, complete: int) -> "_ActiveCount":
+        width = min(offset, _HEAD_BYTES)
+        return cls(stat.st_dev, stat.st_ino, offset, complete, os.pread(fd, width, 0),
+                   os.pread(fd, width, offset - width))
+
+    def unchanged(self, fd: int, stat: os.stat_result) -> bool:
+        """The counted part is still on disk exactly where and as it was."""
+        return ((stat.st_dev, stat.st_ino) == (self.dev, self.ino)
+                and stat.st_size >= self.offset
+                and os.pread(fd, len(self.head), 0) == self.head
+                and os.pread(fd, len(self.tail), self.offset - len(self.tail)) == self.tail)
+
+
+def _tally(lines: Iterator[bytes]) -> tuple[int, int, bool] | None:
+    """Count lines the way `active_records` does, over raw bytes split on b"\\n".
+
+    Returns (non-blank complete lines, bytes through the last newline, whether a non-blank
+    unterminated line follows), or None for anything this cannot count identically: a b"\\r",
+    which text mode would also treat as a line break, or bytes that do not decode, which text
+    mode would raise on. The caller then counts the old way, error and all.
+    """
+    complete = consumed = 0
+    partial = False
+    for raw in lines:
+        if b"\r" in raw:
+            return None
+        try:
+            blank = not raw.decode(_TEXT_ENCODING).strip()
+        except UnicodeDecodeError:
+            return None
+        if raw.endswith(b"\n"):
+            consumed += len(raw)
+            complete += not blank
+        else:
+            partial = not blank
+    return complete, consumed, partial
+
+
