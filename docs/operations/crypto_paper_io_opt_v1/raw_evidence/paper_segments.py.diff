+#: line by line itself, which only gives the same answer for a codec where b"\n" can never sit
+#: inside a character. Anything else keeps the whole-file count.
+_TEXT_ENCODING = codecs.lookup(io.TextIOWrapper(io.BytesIO()).encoding).name
