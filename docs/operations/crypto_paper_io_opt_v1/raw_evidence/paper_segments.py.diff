+
+    def _count_active(self) -> int:
+        """`active_records()`, reading only what was appended since the last call.
+
+        The observe loop asks this once a second, and counting the whole active tape each time
+        read up to a segment's worth of JSON (about 4.5MB at the cut) every second to learn
+        that one line had been added. The answer is still taken from the disk, never from a
+        count of our own appends, so a writer this object does not know about is counted too.
+
+        The remembered position is only trusted while the file is visibly the same one, grown
+        by appending: same device and inode, not shorter, and the same bytes at the start and
+        at the end of the counted part. Anything else - truncation, replacement, a rewrite
+        under the counted part - re-reads the whole file, which is the old answer.
+        """
+        try:
+            fd = os.open(self.active_path, os.O_RDONLY)
+        except FileNotFoundError:
+            self._active = None
+            return 0
+        try:
+            stat = os.fstat(fd)
+            known = self._active
+            if _INCREMENTAL_COUNT and known is not None and known.unchanged(fd, stat):
+                appended = os.pread(fd, stat.st_size - known.offset, known.offset)
+                tally = _tally(iter(appended.splitlines(keepends=True)))
+                if tally is not None:
+                    complete, consumed, partial = tally
+                    if consumed:
+                        self._active = _ActiveCount.read(fd, stat, known.offset + consumed,
+                                                         known.complete + complete)
+                    return known.complete + complete + partial
+            return self._rescan_active(fd, stat)
+        finally:
+            os.close(fd)
+
+    def _rescan_active(self, fd: int, stat: os.stat_result) -> int:
+        self.active_full_scans += 1
+        self._active = None
+        if _INCREMENTAL_COUNT:
+            with os.fdopen(os.dup(fd), "rb") as handle:
+                handle.seek(0)
+                tally = _tally(iter(handle))
+            if tally is not None:
+                complete, consumed, partial = tally
+                self._active = _ActiveCount.read(fd, stat, consumed, complete)
+                return complete + partial
+        return self.active_records()
 
