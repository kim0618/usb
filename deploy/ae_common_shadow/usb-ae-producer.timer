[Unit]
Description=Start the A/E common producer before the 04:00 ET premarket (armed session only)

[Timer]
# usb-e-paper's own slot. The service's ExecCondition skips every day but the armed one.
OnCalendar=Mon..Fri 03:45 America/New_York
Persistent=false
AccuracySec=1s
Unit=usb-ae-producer.service

[Install]
WantedBy=timers.target
