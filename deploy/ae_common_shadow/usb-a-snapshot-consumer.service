[Unit]
Description=USB Strategy A-MOVER-LIVE-V1 consumer of the common snapshot_0915 (no Kiwoom; scan + handoff as before)
After=network-online.target usb-backend.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
ExecCondition=/bin/sh -c 'test -f /root/usb_runtime/ae_common_producer/ACTIVE_SESSION && test "$(cat /root/usb_runtime/ae_common_producer/ACTIVE_SESSION)" = "$(TZ=America/New_York date +%%F)"'
# The A/E operations tree: A's own code, data authority and database exactly as inside usb-e-paper.
# Three new files (app/ae_common/{__init__,snapshot,a_consumer}.py) are added to it; nothing replaced.
WorkingDirectory=/root/usb_runtime/strategy_e_paper/src/backend
EnvironmentFile=/root/usb/.env
Environment=PYTHONPATH=/root/usb_runtime/strategy_e_paper/src/backend
Environment=STRATEGY_E_MAX_ENABLED=false
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/usb/.venv/bin/python -m app.ae_common.a_consumer run \
  --snapshots /root/usb_runtime/ae_common_producer/snapshots \
  --out /root/usb_runtime/ae_common_producer/a_consumer
# one attempt: a second start finds a_consumer.json and does nothing
Restart=no
MemoryMax=300M
# E's 09:25 finalization and seal (in the producer) outrank A's scan on this one-core host
Nice=10
CPUWeight=20
