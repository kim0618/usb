# US-B CRYPTO BTC context strip API (btc_context_ui_v1). Read by usb-btc-context-ui.service
# through EnvironmentFile=. No key, token, URL or account here, and none may be added: the API
# reads no credential, answers GET only and writes nothing.
#
# The production Context Collector's persistent root. Read only: the API opens
# <root>/state/context_latest.json (a link into the collector's tmpfs cache) and nothing else.
CTX_V1_ROOT=/root/usb_runtime/crypto_context/journal
# GET-only API, bound to 127.0.0.1. Confirm the port is free on the host before the first start.
BTC_CONTEXT_UI_PORT=8014
# The structure worker's state directory (usb-btc-context-structure.service writes here, and only
# here: the R1 engine checkpoint and the snapshot). The API reads the snapshot and nothing else.
BTC_CONTEXT_STATE_DIR=/root/usb_runtime/btc_context_ui/state
BTC_CONTEXT_STRUCTURE_SNAPSHOT=/root/usb_runtime/btc_context_ui/state/structure_snapshot.json
