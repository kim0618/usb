# US-B CRYPTO Q1/Q2/Q3 forward recorder. Read by usb-crypto-q123-forward.service. No key, token or
# account here, and none may be added: the recorder reads no credential.
#
# The Context Collector journal. Read only (the unit mounts it read only).
Q123_COLLECTOR_ROOT=/root/usb_runtime/crypto_context/journal
# The permanent research store. NO retention: kept until the research ends or the user approves.
Q123_STORE=/root/usb_runtime/q123_forward/store
# Rebuildable runtime: checkpoints, kline cache, status.json. Safe to delete (full replay).
Q123_RUNTIME=/root/usb_runtime/q123_forward/runtime
Q123_POLL_S=15
