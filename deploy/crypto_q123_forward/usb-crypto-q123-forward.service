[Unit]
Description=US-B CRYPTO Q1/Q2/Q3 forward recorder (research only: reads the context journal and public klines; no order, no account, no key)
Documentation=file:/root/usb_runtime/q123_forward/src/docs/crypto/q123_forward_v1/FORWARD_RECORDER_V1.md
After=network-online.target
Wants=network-online.target
# No Requires=/Wants=/After=/PartOf= on usb-crypto-context or any other usb unit, and nothing
# depends on this one. When the collector stops, this unit keeps running and reports
# WAITING_FOR_DATA; when this unit fails, nothing else notices.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/usb_runtime/q123_forward
EnvironmentFile=/root/usb_runtime/q123_forward/config/q123_forward.env
# Its own source snapshot; the venv is shared read-only with the other usb units.
Environment=PYTHONPATH=/root/usb_runtime/q123_forward/src/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/usb/.venv/bin/python -m app.crypto.research.q123_forward_v1.recorder record \
  --root ${Q123_COLLECTOR_ROOT} --store ${Q123_STORE} --runtime ${Q123_RUNTIME} --poll-s ${Q123_POLL_S}
StandardOutput=append:/root/usb_runtime/q123_forward/logs/recorder.log
StandardError=append:/root/usb_runtime/q123_forward/logs/recorder.log
Restart=on-failure
RestartSec=30
# 5 = the store does not parse. A restart cannot fix it and must not paper over it.
RestartPreventExitStatus=5
KillSignal=SIGTERM
TimeoutStopSec=60
# The filesystem is read only except this unit's own root. The collector journal is mounted read
# only into the unit, so a defect here cannot write to it even as root.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/usb_runtime/q123_forward
ReadOnlyPaths=/root/usb_runtime/crypto_context/journal
PrivateTmp=true
NoNewPrivileges=true
# Measured locally: steady RSS ~60-120 MB, CPU ~1-3% (FORWARD_RECORDER_V1.md R). Caps are the blast
# radius on a host that has been OOM-hit before. Lowest CPU and IO priority on the host.
MemoryMax=180M
CPUQuota=15%
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
