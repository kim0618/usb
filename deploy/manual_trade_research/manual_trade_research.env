# US-B CRYPTO Manual Trade Snapshot Store V1 recorder. Read by usb-crypto-manual-research.service.
# No key, token or account secret here, and none may be added: the recorder reads files other
# processes write, public market data, and (optionally) the terminal's own GET.
#
# S1: the terminal's durable Binance fill cache for BTCUSDT (read only).
MTR_S1=/root/usb_runtime/crypto_paper/data/runtime/crypto/live/manual_performance.json
# S2: the LIVE audit mirror. The directory is the API key fingerprint; confirm it on the host.
MTR_S2=/root/usb_runtime/crypto_paper/data/runtime/crypto/live/487ea08e/binance_live_events.jsonl
# S3: the Context Collector journal root (read only).
MTR_JOURNAL=/root/usb_runtime/crypto_context/journal
# The recorder's own store, its only writable path.
MTR_STORE=/root/usb_runtime/manual_trade_research
# Optional: the terminal's GET that refreshes S1 (at most once per 5 minutes). Empty disables it.
MTR_TRIGGER_URL=http://127.0.0.1:8100/api/crypto/binance/performance?symbol=BTCUSDT
# Public REST budget per run. The host shares its IP with the terminal's Binance reads.
MTR_REQUEST_BUDGET=12
MTR_REQUEST_SPACING_S=0.25
