[Unit]
Description=Run Strategy H autonomous research after the H daily update

[Timer]
# 30 minutes after usb-h-forward (01:10 ET), which finishes in seconds; the shared lock still
# orders the two if the update runs late. 01:40 ET is 2h05m ahead of the 03:45 ET paper start that
# attaches Strategy A, and the research run calls neither Massive nor anything A or E owns.
OnCalendar=Mon..Fri 01:40 America/New_York
Persistent=true
AccuracySec=1m
RandomizedDelaySec=0
Unit=usb-h-research.service

[Install]
WantedBy=timers.target
