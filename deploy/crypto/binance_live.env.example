# US-B CRYPTO - Binance USDs-M LIVE manual trading, template.
#
# The real file lives on the production host at
#   /root/usb_runtime/crypto_paper/secrets/binance_live.env   (600 root:root)
# and is loaded by usb-crypto-paper.service through a single EnvironmentFile= line.
# It is never committed. This template exists so the shape is reviewable and so the host can be
# rebuilt without guessing which variables the service expects.
#
# The equity /root/usb/.env is deliberately NOT loaded by that service. A separate scoped file
# is what keeps crypto out of the Kiwoom credentials and the equity services out of this key.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Capability, not an arm. `true` says this deployment *may* send an order; whether it is
# currently able to is a second, in-memory gate (see below). Default is false, and any value
# other than 1/true/yes/on is false.
BINANCE_LIVE_TRADING_ENABLED=true

# Ceiling on new OPEN orders, in BTC. A CLOSE is never bounded by it, so a position can always
# be flattened whatever size it is - including one larger than this, opened elsewhere.
#
# 0.01 is roughly 830 USDT of notional at current prices, which does not constrain manual use
# on this account and still refuses the common fat-finger (one misplaced decimal) from our own
# code with a named reason, rather than leaving it to a Binance margin error that stops helping
# as the account grows. Unset means only the exchange's filters apply.
BINANCE_LIVE_MAX_QTY=0.01

# BINANCE_LIVE_CLIENT_ARMED is deliberately ABSENT and must stay absent here.
#
# Setting it arms the process from boot and never disarms it, which is right for a one-off
# local validation run and wrong for a server: it would defeat the ArmSession entirely. On this
# host the second gate is that session - held only in memory, opened by a confirmation phrase
# typed in the UI, expiring on its own, and gone after any restart.
